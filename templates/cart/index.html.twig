{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 mb-8">Mon panier</h1>

    {% if cart is null or cart.items is empty %}
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
            <p class="text-5xl mb-4">🛒</p>
            <p class="text-gray-500 text-lg mb-6">Votre panier est vide.</p>
            <a href="{{ path('app_product_index') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition">
                Découvrir le catalogue
            </a>
        </div>
    {% else %}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            {# Liste des articles #}
            <div class="lg:col-span-2 space-y-4">
                {% for item in cart.items %}
                {% set catStyles = {
                    'electronique':  {bg: 'from-blue-50 to-blue-100',    icon: '💻'},
                    'vetements':     {bg: 'from-pink-50 to-pink-100',    icon: '👕'},
                    'maison-jardin': {bg: 'from-green-50 to-green-100',  icon: '🏡'},
                    'sport':         {bg: 'from-orange-50 to-orange-100', icon: '🏃'},
                } %}
                {% set style = catStyles[item.product.category.slug] ?? {bg: 'from-gray-50 to-gray-100', icon: '🛍️'} %}
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex gap-4 items-center">
                    <div class="w-16 h-16 bg-gradient-to-br {{ style.bg }} rounded-xl flex items-center justify-center shrink-0">
                        <span class="text-2xl">{{ style.icon }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <a href="{{ path('app_product_show', {slug: item.product.slug}) }}"
                           class="font-semibold text-gray-900 hover:text-indigo-600 truncate block">
                            {{ item.product.name }}
                        </a>
                        <p class="text-sm text-gray-400">{{ item.product.category.name }}</p>
                        <p class="text-indigo-600 font-semibold mt-1">{{ item.product.price|number_format(2, ',', ' ') }} € / unité</p>
                    </div>

                    {# Quantité #}
                    <form method="post" action="{{ path('app_cart_update', {itemId: item.id}) }}" class="flex items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.id) }}">
                        <input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="99"
                               class="w-16 border border-gray-300 rounded-lg px-2 py-1 text-sm text-center focus:outline-none focus:ring-2 focus:ring-indigo-500"
                               onchange="this.form.submit()">
                    </form>

                    <p class="w-24 text-right font-bold text-gray-900">{{ item.subtotal|number_format(2, ',', ' ') }} €</p>

                    {# Supprimer #}
                    <form method="post" action="{{ path('app_cart_remove', {itemId: item.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.id) }}">
                        <button type="submit" class="text-gray-300 hover:text-red-500 transition" title="Retirer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </form>
                </div>
                {% endfor %}

                {# Vider le panier #}
                <form method="post" action="{{ path('app_cart_clear') }}" class="text-right">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_clear') }}">
                    <button type="submit" class="text-sm text-gray-400 hover:text-red-500 transition">
                        Vider le panier
                    </button>
                </form>
            </div>

            {# Récapitulatif #}
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sticky top-8">
                    <h2 class="text-lg font-bold text-gray-900 mb-4">Récapitulatif</h2>
                    <div class="space-y-2 text-sm text-gray-600 mb-4">
                        <div class="flex justify-between">
                            <span>Articles ({{ cart.totalItems }})</span>
                            <span>{{ cart.total|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Livraison</span>
                            <span class="text-green-600">Gratuite</span>
                        </div>
                    </div>
                    <div class="border-t border-gray-100 pt-4 flex justify-between font-bold text-gray-900 mb-6">
                        <span>Total</span>
                        <span>{{ cart.total|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <form method="post" action="{{ path('app_order_place') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('order_place') }}">
                        <button type="submit" class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition text-center">
                            Passer la commande
                        </button>
                    </form>
                </div>
            </div>

        </div>
    {% endif %}
</div>
{% endblock %}
