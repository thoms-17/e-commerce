<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Symfony Shop{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-gray-50 text-gray-900">

        <nav id="main-nav" class="sticky top-0 z-50 bg-white shadow-sm border-b border-gray-200 transition-shadow duration-300">
            <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="text-xl font-bold text-indigo-600">Symfony Shop</a>
                <div class="flex gap-4 text-sm items-center">
                    <a href="{{ path('app_home') }}" class="text-gray-600 hover:text-indigo-600">Accueil</a>
                    <a href="{{ path('app_product_index') }}" class="text-gray-600 hover:text-indigo-600">Catalogue</a>
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_dashboard') }}" class="text-orange-600 hover:text-orange-700 font-semibold">Admin</a>
                        {% endif %}
                        <a href="{{ path('app_order_history') }}" class="text-gray-600 hover:text-indigo-600">Mes commandes</a>
                        <a href="{{ path('app_cart_index') }}" class="relative text-gray-600 hover:text-indigo-600">
                            Panier
                            {% if cart_count > 0 %}
                                <span class="absolute -top-2 -right-2 bg-indigo-600 text-white text-xs font-bold rounded-full w-4 h-4 flex items-center justify-center">{{ cart_count }}</span>
                            {% endif %}
                        </a>
                        <span class="text-gray-400">{{ app.user.userIdentifier }}</span>
                        <a href="{{ path('app_logout') }}" class="text-gray-600 hover:text-red-600">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-gray-600 hover:text-indigo-600">Connexion</a>
                        <a href="{{ path('app_register') }}" class="bg-indigo-600 text-white px-3 py-1 rounded-lg hover:bg-indigo-700 transition">S'inscrire</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main class="max-w-6xl mx-auto px-4 py-8">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 px-4 py-3 rounded {% if label == 'success' %}bg-green-100 text-green-800{% elseif label == 'danger' %}bg-red-100 text-red-800{% else %}bg-blue-100 text-blue-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="mt-16 border-t border-gray-200 py-6 text-center text-sm text-gray-400">
            Symfony Shop &mdash; Projet portfolio
        </footer>

        <script>
            (function () {
                var nav = document.getElementById('main-nav');
                window.addEventListener('scroll', function () {
                    if (window.scrollY > 10) {
                        nav.classList.add('shadow-md');
                        nav.classList.remove('shadow-sm');
                    } else {
                        nav.classList.add('shadow-sm');
                        nav.classList.remove('shadow-md');
                    }
                }, { passive: true });
            })();
        </script>
    </body>
</html>
