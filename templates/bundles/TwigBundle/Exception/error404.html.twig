{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
<div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <p class="text-7xl font-black text-gray-100">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-800">Page introuvable</h1>
    <p class="mt-2 text-gray-400 max-w-md">
        La page que vous cherchez n'existe pas ou a été déplacée.
    </p>
    <a href="{{ path('app_home') }}"
       class="mt-8 inline-block bg-indigo-600 text-white text-sm font-medium px-6 py-3 rounded-xl hover:bg-indigo-700 transition">
        Retour à l'accueil
    </a>
</div>
{% endblock %}
