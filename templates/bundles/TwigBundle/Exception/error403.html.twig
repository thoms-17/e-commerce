{% extends 'base.html.twig' %}

{% block title %}Accès interdit{% endblock %}

{% block body %}
<div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <p class="text-7xl font-black text-gray-100">403</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-800">Accès interdit</h1>
    <p class="mt-2 text-gray-400 max-w-md">
        Vous n'avez pas les droits nécessaires pour accéder à cette page.
    </p>
    <div class="mt-8 flex gap-3">
        <a href="{{ path('app_home') }}"
           class="inline-block bg-indigo-600 text-white text-sm font-medium px-6 py-3 rounded-xl hover:bg-indigo-700 transition">
            Retour à l'accueil
        </a>
        {% if not app.user %}
        <a href="{{ path('app_login') }}"
           class="inline-block bg-white border border-gray-200 text-gray-700 text-sm font-medium px-6 py-3 rounded-xl hover:bg-gray-50 transition">
            Se connecter
        </a>
        {% endif %}
    </div>
</div>
{% endblock %}
