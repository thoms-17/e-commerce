{% extends 'admin/layout.html.twig' %}

{% block title %}Produits — Admin{% endblock %}

{% block admin_body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Produits</h1>
    <a href="{{ path('app_admin_product_new') }}"
       class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl transition text-sm">
        + Nouveau produit
    </a>
</div>

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    {% if products is empty %}
        <p class="px-6 py-10 text-center text-gray-400">Aucun produit.</p>
    {% else %}
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 border-b border-gray-100">
                <tr>
                    <th class="text-left px-5 py-3 font-medium">Nom</th>
                    <th class="text-left px-5 py-3 font-medium">Catégorie</th>
                    <th class="text-right px-5 py-3 font-medium">Prix</th>
                    <th class="text-right px-5 py-3 font-medium">Stock</th>
                    <th class="text-right px-5 py-3 font-medium">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for product in products %}
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-5 py-3 font-medium text-gray-900">{{ product.name }}</td>
                    <td class="px-5 py-3 text-gray-500">{{ product.category.name }}</td>
                    <td class="px-5 py-3 text-right">{{ product.price|number_format(2, ',', ' ') }} €</td>
                    <td class="px-5 py-3 text-right">
                        {% if product.stock == 0 %}
                            <span class="text-red-500 font-semibold">0</span>
                        {% else %}
                            {{ product.stock }}
                        {% endif %}
                    </td>
                    <td class="px-5 py-3 text-right">
                        <div class="flex justify-end gap-2">
                            <a href="{{ path('app_admin_product_edit', {id: product.id}) }}"
                               class="text-indigo-600 hover:underline text-sm">Modifier</a>
                            <form method="post" action="{{ path('app_admin_product_delete', {id: product.id}) }}"
                                  onsubmit="return confirm('Supprimer ce produit ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('product_delete_' ~ product.id) }}">
                                <button type="submit" class="text-red-500 hover:underline text-sm">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
