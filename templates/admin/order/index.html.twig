{% extends 'admin/layout.html.twig' %}

{% block title %}Commandes — Admin{% endblock %}

{% block admin_body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Commandes</h1>
    <span class="text-sm text-gray-400">{{ orders|length }} commande{{ orders|length > 1 ? 's' : '' }}</span>
</div>

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    {% if orders is empty %}
        <p class="px-6 py-10 text-center text-gray-400">Aucune commande.</p>
    {% else %}
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-500 border-b border-gray-100">
                <tr>
                    <th class="text-left px-5 py-3 font-medium">#</th>
                    <th class="text-left px-5 py-3 font-medium">Client</th>
                    <th class="text-left px-5 py-3 font-medium">Date</th>
                    <th class="text-right px-5 py-3 font-medium">Articles</th>
                    <th class="text-right px-5 py-3 font-medium">Total</th>
                    <th class="text-right px-5 py-3 font-medium">Statut</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for order in orders %}
                <tr class="hover:bg-gray-50 transition align-middle">
                    <td class="px-5 py-3 font-medium text-gray-700">#{{ order.id }}</td>
                    <td class="px-5 py-3 text-gray-600">{{ order.user.email }}</td>
                    <td class="px-5 py-3 text-gray-400">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="px-5 py-3 text-right text-gray-500">{{ order.items|length }}</td>
                    <td class="px-5 py-3 text-right font-semibold">{{ order.total|number_format(2, ',', ' ') }} €</td>
                    <td class="px-5 py-3 text-right">
                        <form method="post" action="{{ path('app_admin_order_status', {id: order.id}) }}"
                              class="flex items-center justify-end gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('order_status_' ~ order.id) }}">
                            <select name="status"
                                    onchange="this.form.submit()"
                                    class="text-xs rounded-lg border border-gray-200 px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ order.status.badgeClass() }}">
                                {% for status in statuses %}
                                    <option value="{{ status.value }}" {% if status == order.status %}selected{% endif %}>
                                        {{ status.label() }}
                                    </option>
                                {% endfor %}
                            </select>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
