{% extends 'base.html.twig' %}

{% block title %}{{ activeCategory is defined ? activeCategory.name ~ ' — ' : '' }}Catalogue{% endblock %}

{% block body %}
<div class="flex gap-8">

    {# Sidebar catégories #}
    <aside class="w-48 shrink-0">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-3">Catégories</h2>
        <ul class="space-y-1">
            <li>
                <a href="{{ path('app_product_index') }}"
                   class="block px-3 py-2 rounded-lg text-sm {{ activeCategory is not defined ? 'bg-indigo-50 text-indigo-700 font-medium' : 'text-gray-600 hover:bg-gray-100' }}">
                    Tous les produits
                </a>
            </li>
            {% for category in categories %}
            <li>
                <a href="{{ path('app_product_by_category', {slug: category.slug}) }}"
                   class="block px-3 py-2 rounded-lg text-sm {{ activeCategory is defined and activeCategory.slug == category.slug ? 'bg-indigo-50 text-indigo-700 font-medium' : 'text-gray-600 hover:bg-gray-100' }}">
                    {{ category.name }}
                </a>
            </li>
            {% endfor %}
        </ul>
    </aside>

    {# Grille produits #}
    <div class="flex-1">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">
            {{ activeCategory is defined ? activeCategory.name : 'Tous les produits' }}
            <span class="text-base font-normal text-gray-400 ml-2">{{ products|length }} article{{ products|length > 1 ? 's' : '' }}</span>
        </h1>

        {% if products is empty %}
            <p class="text-gray-500">Aucun produit dans cette catégorie.</p>
        {% else %}
            {# Tailwind safelist: from-blue-50 to-blue-100 from-pink-50 to-pink-100 from-green-50 to-green-100 from-orange-50 to-orange-100 from-gray-50 to-gray-100 #}
            {% set catStyles = {
                'electronique':  {bg: 'from-blue-50 to-blue-100',    icon: '💻'},
                'vetements':     {bg: 'from-pink-50 to-pink-100',    icon: '👕'},
                'maison-jardin': {bg: 'from-green-50 to-green-100',  icon: '🏡'},
                'sport':         {bg: 'from-orange-50 to-orange-100', icon: '🏃'},
            } %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for product in products %}
                {% set style = catStyles[product.category.slug] ?? {bg: 'from-gray-50 to-gray-100', icon: '🛍️'} %}
                <div class="relative group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md hover:scale-[1.02] transition-all duration-200">
                    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="block">
                        <div class="h-48 bg-gradient-to-br {{ style.bg }} flex items-center justify-center">
                            <span class="text-5xl">{{ style.icon }}</span>
                        </div>
                        <div class="p-4">
                            <p class="text-xs text-indigo-500 font-medium mb-1">{{ product.category.name }}</p>
                            <h3 class="font-semibold text-gray-900 group-hover:text-indigo-600 transition line-clamp-2">{{ product.name }}</h3>
                            <div class="flex items-center justify-between mt-3">
                                <span class="text-lg font-bold text-gray-900">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                {% if product.stock > 0 %}
                                    <span class="text-xs text-green-600 bg-green-50 px-2 py-1 rounded-full">En stock</span>
                                {% else %}
                                    <span class="text-xs text-red-500 bg-red-50 px-2 py-1 rounded-full">Rupture</span>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                    {% if app.user and product.stock > 0 %}
                    <div class="absolute bottom-0 left-0 right-0 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                        <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-3 transition-colors">
                                + Ajouter au panier
                            </button>
                        </form>
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
