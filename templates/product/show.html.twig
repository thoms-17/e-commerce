{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">

    {# Fil d'Ariane #}
    <nav class="text-sm text-gray-400 mb-6">
        <a href="{{ path('app_product_index') }}" class="hover:text-indigo-600">Catalogue</a>
        <span class="mx-2">›</span>
        <a href="{{ path('app_product_by_category', {slug: product.category.slug}) }}" class="hover:text-indigo-600">{{ product.category.name }}</a>
        <span class="mx-2">›</span>
        <span class="text-gray-700">{{ product.name }}</span>
    </nav>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2">

            {# Image #}
            {% set catStyles = {
                'electronique':  {bg: 'from-blue-50 to-blue-100',    icon: '💻'},
                'vetements':     {bg: 'from-pink-50 to-pink-100',    icon: '👕'},
                'maison-jardin': {bg: 'from-green-50 to-green-100',  icon: '🏡'},
                'sport':         {bg: 'from-orange-50 to-orange-100', icon: '🏃'},
            } %}
            {% set style = catStyles[product.category.slug] ?? {bg: 'from-gray-50 to-gray-100', icon: '🛍️'} %}
            <div class="h-80 md:h-auto bg-gradient-to-br {{ style.bg }} flex items-center justify-center">
                <span class="text-8xl">{{ style.icon }}</span>
            </div>

            {# Infos #}
            <div class="p-8 flex flex-col justify-between">
                <div>
                    <p class="text-sm text-indigo-500 font-medium mb-2">{{ product.category.name }}</p>
                    <h1 class="text-3xl font-bold text-gray-900 mb-4">{{ product.name }}</h1>
                    <p class="text-gray-600 leading-relaxed mb-6">{{ product.description }}</p>
                </div>

                <div>
                    <div class="flex items-center gap-4 mb-6">
                        <span class="text-4xl font-bold text-gray-900">{{ product.price|number_format(2, ',', ' ') }} €</span>
                        {% if product.stock > 0 %}
                            <span class="text-sm text-green-600 bg-green-50 px-3 py-1 rounded-full font-medium">
                                En stock ({{ product.stock }} disponibles)
                            </span>
                        {% else %}
                            <span class="text-sm text-red-500 bg-red-50 px-3 py-1 rounded-full font-medium">Rupture de stock</span>
                        {% endif %}
                    </div>

                    {% if product.stock > 0 %}
                        {% if app.user %}
                            <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition text-lg">
                                    Ajouter au panier
                                </button>
                            </form>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition text-lg text-center">
                                Connectez-vous pour acheter
                            </a>
                        {% endif %}
                    {% else %}
                        <button disabled class="w-full bg-gray-200 text-gray-400 font-semibold py-3 rounded-xl cursor-not-allowed text-lg">
                            Indisponible
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_product_by_category', {slug: product.category.slug}) }}"
           class="text-sm text-indigo-600 hover:underline">
            ← Retour à {{ product.category.name }}
        </a>
    </div>

</div>
{% endblock %}
