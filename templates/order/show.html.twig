{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.id }}{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto">

    {# En-tête #}
    <div class="flex items-start justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Commande #{{ order.id }}</h1>
            <p class="text-sm text-gray-400 mt-1">Passée le {{ order.createdAt|date('d/m/Y à H:i') }}</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium {{ order.status.badgeClass() }}">
            {{ order.status.label() }}
        </span>
    </div>

    {# Articles #}
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="text-left px-5 py-3 text-gray-500 font-medium">Article</th>
                    <th class="text-right px-5 py-3 text-gray-500 font-medium">Prix unit.</th>
                    <th class="text-right px-5 py-3 text-gray-500 font-medium">Qté</th>
                    <th class="text-right px-5 py-3 text-gray-500 font-medium">Sous-total</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for item in order.items %}
                <tr>
                    <td class="px-5 py-4 font-medium text-gray-900">{{ item.productName }}</td>
                    <td class="px-5 py-4 text-right text-gray-600">{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                    <td class="px-5 py-4 text-right text-gray-600">{{ item.quantity }}</td>
                    <td class="px-5 py-4 text-right font-semibold text-gray-900">{{ item.subtotal|number_format(2, ',', ' ') }} €</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="border-t border-gray-200 bg-gray-50">
                <tr>
                    <td colspan="3" class="px-5 py-4 text-right font-bold text-gray-900">Total</td>
                    <td class="px-5 py-4 text-right font-bold text-indigo-600 text-lg">{{ order.total|number_format(2, ',', ' ') }} €</td>
                </tr>
            </tfoot>
        </table>
    </div>

    {# Actions #}
    <div class="flex gap-3">
        <a href="{{ path('app_order_history') }}" class="text-sm text-gray-500 hover:text-indigo-600 transition">
            ← Retour à mes commandes
        </a>
    </div>

</div>
{% endblock %}
